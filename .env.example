# ─── Optional data providers ────────────────────────────────────────────────
# Everything runs without these. They only unlock richer signals.

# Birdeye (holder distribution, whale flow, OHLCV)  -> https://birdeye.so/
BIRDEYE_API_KEY=

# Helius (Solana RPC, token metadata, mint authority checks) -> https://helius.dev/
HELIUS_API_KEY=

# ─── Optional narrative layer ───────────────────────────────────────────────
# When set, the NARRATIVE agent uses Claude to read the story behind a ticker.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Engine ─────────────────────────────────────────────────────────────────
# live | simulated | auto   (auto = try live, fall back to simulator)
MARKET_MODE=auto
TICK_INTERVAL_MS=4000
